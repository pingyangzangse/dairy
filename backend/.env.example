# DeepTalk 认证数据库（用于用户认证和共享 token）
AUTH_DB_HOST=your-rds-host.mysql.rds.aliyuncs.com
AUTH_DB_PORT=3306
AUTH_DB_USER=Knowledge_Admin
AUTH_DB_PASSWORD=your-password
AUTH_DB_NAME=knowledge

# 日记业务数据库
DIARY_DB_HOST=your-rds-host.mysql.rds.aliyuncs.com
DIARY_DB_PORT=3306
DIARY_DB_USER=diary_admin
DIARY_DB_PASSWORD=your-password
DIARY_DB_NAME=dairy

# 服务端口
PORT=3002

# 文件上传目录
UPLOAD_DIR=./uploads

# SMTP 邮件服务（可选，用于邮箱验证码登录）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 钱包登录域名配置（可选，用于 SIWE 登录）
APP_DOMAIN=localhost
APP_NAME=Diary
